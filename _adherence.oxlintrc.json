{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/**",
              "components/icons/**",
              "doc-page.js",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Red Hat Display|Open Sans|Dela Gothic One))/i]",
        "message": "Font not provided by the design system. Available: Red Hat Display, Open Sans, Dela Gothic One."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|variant|badge|icon|image|text1|icon1|icon2|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: className, style, variant, badge, icon, image, text1, icon1, icon2."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:circle|rounded|square)$/]",
        "message": "<Avatar> variant must be one of 'circle' | 'rounded' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|variant|color|text1|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: className, style, variant, color, text1."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:standard|dot)$/]",
        "message": "<Badge> variant must be one of 'standard' | 'dot'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:default|primary|secondary|error|warning|info|success)$/]",
        "message": "<Badge> color must be one of 'default' | 'primary' | 'secondary' | 'error' | 'warning' | 'info' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Camera'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<Camera> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Confetti'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|skinTone|key|ref|className|style|children)$/]",
        "message": "<Confetti> doesn't accept that prop. Declared props: className, style, skinTone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Confetti'] > JSXAttribute[name.name='skinTone'] > Literal[value!=/^(?:light|medium|dark)$/]",
        "message": "<Confetti> skinTone must be one of 'light' | 'medium' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DevicesAppleIPadAir4'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<DevicesAppleIPadAir4> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DevicesAppleIPhone12ProMax'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|icon1|icon2|key|ref|className|style|children)$/]",
        "message": "<DevicesAppleIPhone12ProMax> doesn't accept that prop. Declared props: className, style, icon1, icon2."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormatoDePag'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|text2|key|ref|className|style|children)$/]",
        "message": "<FormatoDePag> doesn't accept that prop. Declared props: className, style, text1, text2."
      },
      {
        "selector": "JSXOpeningElement[name.name='Gif'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|property1|text1|text2|text3|text4|key|ref|className|style|children)$/]",
        "message": "<Gif> doesn't accept that prop. Declared props: className, style, property1, text1, text2, text3, text4."
      },
      {
        "selector": "JSXOpeningElement[name.name='Gif'] > JSXAttribute[name.name='property1'] > Literal[value!=/^(?:default|variant4|variant5|variant6|variant7)$/]",
        "message": "<Gif> property1 must be one of 'default' | 'variant4' | 'variant5' | 'variant6' | 'variant7'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|size|icon1|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: className, style, size, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg|sm)$/]",
        "message": "<Icon> size must be one of 'md' | 'lg' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyboardArrowDownFilled'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<KeyboardArrowDownFilled> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|property1|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: className, style, property1."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='property1'] > Literal[value!=/^(?:white|dark)$/]",
        "message": "<Logo> property1 must be one of 'white' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoGridHover'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|property1|key|ref|className|style|children)$/]",
        "message": "<LogoGridHover> doesn't accept that prop. Declared props: className, style, property1."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoGridHover'] > JSXAttribute[name.name='property1'] > Literal[value!=/^(?:default|variant2)$/]",
        "message": "<LogoGridHover> property1 must be one of 'default' | 'variant2'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Name'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|key|ref|className|style|children)$/]",
        "message": "<Name> doesn't accept that prop. Declared props: className, style, text1."
      },
      {
        "selector": "JSXOpeningElement[name.name='Scribble'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<Scribble> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Scribble2'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<Scribble2> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionAgradecimiento'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|property1|text1|text2|text3|text4|key|ref|className|style|children)$/]",
        "message": "<SectionAgradecimiento> doesn't accept that prop. Declared props: className, style, property1, text1, text2, text3, text4."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionAgradecimiento'] > JSXAttribute[name.name='property1'] > Literal[value!=/^(?:default|variant2|variant3)$/]",
        "message": "<SectionAgradecimiento> property1 must be one of 'default' | 'variant2' | 'variant3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SideNavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|text2|text3|text4|icon1|key|ref|className|style|children)$/]",
        "message": "<SideNavBar> doesn't accept that prop. Declared props: className, style, text1, text2, text3, text4, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='Speaker'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<Speaker> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Star'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<Star> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Value'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|property1|text1|icon1|key|ref|className|style|children)$/]",
        "message": "<Value> doesn't accept that prop. Declared props: className, style, property1, text1, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='Value'] > JSXAttribute[name.name='property1'] > Literal[value!=/^(?:default|hover)$/]",
        "message": "<Value> property1 must be one of 'default' | 'hover'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ValueFaster'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<ValueFaster> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wow'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<Wow> doesn't accept that prop. Declared props: className, style."
      }
    ]
  },
